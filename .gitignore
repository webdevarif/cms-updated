# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ===========================================
# Global Git Ignore for Digital Farmers CMS
# ===========================================

# ===========================================
# Dependencies & Package Management
# ===========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn-integrity
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
jspm_packages/
.pnp
.pnp.*

# ===========================================
# Build Outputs & Distribution
# ===========================================
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.vercel

# ===========================================
# Environment Variables & Secrets
# ===========================================
.env*
!.env.example
!.env.local.example

# ===========================================
# IDE & Editor Files
# ===========================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.metadata
.classpath
.c9/
*.launch
.settings/

# ===========================================
# OS Generated Files
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.stackdump

# ===========================================
# Logs & Debug Files
# ===========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ===========================================
# Runtime & Temporary Files
# ===========================================
pids/
*.pid
*.seed
*.pid.lock
.nyc_output
coverage/
*.lcov
.cache
.parcel-cache
.eslintcache
.stylelintcache

# ===========================================
# Testing & Coverage
# ===========================================
coverage/
.nyc_output
*.lcov
.coverage/
coverage.json

# ===========================================
# Documentation Build
# ===========================================
.vuepress/dist
docs/.vuepress/dist

# ===========================================
# Database & Local Development
# ===========================================
*.sqlite
*.db
*.sqlite3
.dynamodb/

# ===========================================
# Serverless & Cloud
# ===========================================
.serverless/
.chalice/
.terraform/

# ===========================================
# Bundler & Build Tools
# ===========================================
.fusebox/
.cache/
.parcel-cache/
.nuxt
.output/

# ===========================================
# Miscellaneous
# ===========================================
*.tgz
*.tar.gz
*.rar
*.zip
*.7z
*.dmg
*.gz
*.bz2
*.xz
*.lzma
*.cab
*.msi
*.msm
*.msp
*.lnk

# ===========================================
# Next.js Applications (frontend/store-*)
# ===========================================
frontend/*/node_modules/
frontend/*/.next/
frontend/*/out/
frontend/*/build/
frontend/*/*.tsbuildinfo
frontend/*/next-env.d.ts
frontend/*/.env
frontend/*/.env.local
frontend/*/.env.development.local
frontend/*/.env.test.local
frontend/*/.env.production.local
frontend/*/.vercel
frontend/*/coverage/
frontend/*/.cache
frontend/*/.eslintcache
frontend/*/.stylelintcache
frontend/*/logs/
frontend/*/*.log
frontend/*/package-lock.json
frontend/*/yarn.lock
frontend/*/pnpm-lock.yaml
frontend/*/tsconfig.tsbuildinfo
