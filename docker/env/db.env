# PostgreSQL Database Configuration
POSTGRES_DB=cms_db
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=your-db-password-here-change-in-production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URL (Django will use this)
DATABASE_URL=postgresql://cms_user:your-db-password-here@db:5432/cms_db

# Optional: Database connection settings
POSTGRES_INITDB_ARGS=--encoding=UTF-8
POSTGRES_INITDB_ARGS=--lc_collate=C
POSTGRES_INITDB_ARGS=--locale=C
